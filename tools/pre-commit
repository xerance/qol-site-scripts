#!/bin/sh
# Refuse a commit whose docs disagree with the scripts' @version headers.
#
# Install:   cp tools/pre-commit .git/hooks/pre-commit
# Remove:    rm .git/hooks/pre-commit
# Skip once: git commit --no-verify
#
# Without node on PATH this does nothing rather than blocking the commit.

command -v node >/dev/null 2>&1 || exit 0

root=$(git rev-parse --show-toplevel) || exit 0
[ -f "$root/tools/sync-readme-versions.js" ] || exit 0

node "$root/tools/sync-readme-versions.js" --check || {
    echo "pre-commit: the versions in the docs don't match the scripts (see above)." >&2
    exit 1
}
